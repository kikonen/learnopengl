# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
# NOTE KI "auto" since in windows/msys mix of CRLF and LF fiels is almost unavoidable
#end_of_line = lf
end_of_line = auto
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
charset = utf-8

# 4 space indentation
[*.cpp]
indent_size = 4

# 4 space indentation
[*.h]
indent_size = 4

# Tab indentation (no size specified)
[Makefile]
indent_style = tab

# NOTE KI breaks them if not strictly CRLF
[*.{bat,cmd}]
end_of_line = crlf

# NOTE KI MAY break them if not strictly CRLF
[*.{filters,vcxproj,vcxproj.user,ini,sln}]
end_of_line = crlf

# NOTE KI breaks them if not strictly LF
[*.{sh}]
end_of_line = lf
