# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
#end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
charset = utf-8
end_of_line = lf

# 4 space indentation
[*.cpp]
indent_size = 4

# 4 space indentation
[*.h]
indent_size = 4

# Tab indentation (no size specified)
[Makefile]
indent_style = tab

[*.{bat,cmd,filters,vcxproj,vcxproj.user,ini,sln}]
end_of_line = crlf

[*.{sh}]
end_of_line = lf
